{
  "name": "solito-blank",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3-scale": "^4",
    "@types/d3-shape": "^3",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.21.0",
    "expo-linking": "^55.0.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.4.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "web": "cd apps/next && yarn next",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "packageManager": "yarn@4.7.0",
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react-native-pure-chart": "^0.0.24",
    "react-native-svg": "^15.15.5"
  }
}
